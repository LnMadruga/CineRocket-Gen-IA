# Copie este arquivo para .env e preencha com sua chave do OpenRouter
# (gerada em https://openrouter.ai/keys, começa com "sk-or-v1-").
OPENROUTER_API_KEY=

# Caminho do banco de dados (padrão: data/cinerocket.db)
DATABASE_PATH=data/cinerocket.db

# Opcional: sobrescreve a lista de modelos (separados por vírgula, em ordem de fallback).
# OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,z-ai/glm-5.2:free,openrouter/free
